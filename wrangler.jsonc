/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fantasy-weekly",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "class_name": "FantasyWeeklyAgent",
        "name": "FantasyWeeklyAgent"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["ChatAgent"],
      "tag": "v1"
    },
    {
      // Replaces the starter template's chat agent with the digest agent.
      "deleted_classes": ["ChatAgent"],
      "new_sqlite_classes": ["FantasyWeeklyAgent"],
      "tag": "v2"
    }
  ],
  // Set with `wrangler secret put`, and mirrored in .dev.vars for local runs.
  "secrets": {
    "required": [
      "ANTHROPIC_API_KEY",
      "SLEEPER_USERNAME",
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_CHAT_ID",
      "TELEGRAM_WEBHOOK_SECRET"
    ]
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
