{
  "name": "fantasy-weekly",
  "version": "1.0.0",
  "private": true,
  "description": "Weekly fantasy football digest agent for Sleeper leagues, delivered on Telegram from Cloudflare",
  "keywords": [
    "agents",
    "cloudflare",
    "fantasy-football",
    "sleeper",
    "telegram"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types env.d.ts",
    "format": "oxfmt --write .",
    "lint": "oxlint src/ test/",
    "check": "oxfmt --check . && oxlint src/ test/ && tsc && tsc -p test",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "agents": "^0.17.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.1",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "core-js-pure@3.49.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true,
    "sharp@0.35.5": true,
    "fsevents@2.3.3": true
  }
}
